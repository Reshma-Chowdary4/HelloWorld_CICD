# Example environment file for the helloworld systemd service
# Copy values into GitHub secret named APP_ENVIRONMENT (multiline) or place on the server at /etc/default/helloworld
# Each line should be KEY=value

# Spring profile
SPRING_PROFILES_ACTIVE=prod

# Java options (optional)
JAVA_OPTS=-Xms256m -Xmx512m

# Application secrets (do NOT commit real secrets; use GitHub Secrets)
#DB_URL=jdbc:postgresql://db.example.com:5432/mydb
#DB_USER=appuser
#DB_PASS=supersecret

